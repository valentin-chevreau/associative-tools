# Suite Touraine-Ukraine — copier en .env (ignoré par git), ne jamais committer.
# En production : placer ce fichier HORS du dossier web (ex. .../secrets/tools.env)
# et l'indiquer à PHP via fastcgi_param SUITE_ENV_FILE dans la config nginx.

# Base de données (source unique pour tous les modules)
DB_HOST=localhost
DB_NAME=touraineukraine_preprod_suite
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------------
# Identité de l'organisme (reçus fiscaux des dons manuels)
# Reprends ici EXACTEMENT les mêmes valeurs que l'ancien
# planning/config/config.php pour que les reçus ne changent pas.
# ---------------------------------------------------------------------------
ORG_NAME=
ORG_RNA=
ORG_SIRET=
ORG_ADDRESS=
ORG_CITY=
ORG_RECEIPT_CITY=

# ---------------------------------------------------------------------------
# API HelloAsso v5 (synchronisation automatique des dons — tâche planifiée)
# ---------------------------------------------------------------------------
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
# HELLOASSO_API_BASE=https://api.helloasso.com

# Filet de sécurité : liste de formSlug HelloAsso à TOUJOURS exclure des
# dons, même si l'API les présente comme tels (ex: un formulaire d'adhésion
# dont order.formType n'est pas renvoyé par l'API et dont les lignes de
# détail sont malgré tout typées "Donation" par HelloAsso). Plusieurs slugs
# séparés par des virgules.
#
# Pour trouver le formSlug à mettre ici : lance une synchro (même en
# simulation) depuis l'onglet "Synchroniser HelloAsso" de l'interface — le
# résultat liste chaque formSlug rencontré avec son nombre de paiements,
# repère celui qui correspond au formulaire d'adhésion en question.
# HELLOASSO_EXCLUDE_FORM_SLUGS=3,adhesion-annuelle-2026

# Traduction automatique (catégories logistique) : clé d'API DeepL, facultative
DEEPL_API_KEY=
